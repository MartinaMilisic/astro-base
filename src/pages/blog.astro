---
import BlogPost from '../components/BlogPost.astro';
import Base from '../layouts/Base.astro';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }))
const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter.tags).flat())]

const pageTitle = "Blog"
---


<Base pageTitle={pageTitle}>
  <p>This is where I will post about my journey learning Astro.</p>

  <div class="tag-filters" role="group" aria-label="Filter posts by tag">
    <button class="tag-filter" data-tag="all" aria-pressed="true">All</button>
    {uniqueTags.map((tag: string) => <button class="tag-filter" data-tag={tag} aria-pressed="false">{tag}</button>)}
  </div>

  <ul id="post-list">
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} imgUrl={post.frontmatter.image.url} tags={post.frontmatter.tags}/>)}
  </ul>

  <script>
    import "../scripts/blog-filter.js";
  </script>
</Base>

<style>
  ul {
    padding: 0;
    list-style: none;
  }
</style>
