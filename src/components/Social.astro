---
const { platform, username } = Astro.props;
---
<style>
  a {
    padding: 1rem 1.2rem;
    color: white;
    background-color: #4c1d95;
    text-decoration: none;
    border-radius: 999px;
  }

  html.dark a {
    color: #fff;
  }

  a:hover, html.dark a:hover {
    color: #ff9776;
  }
</style>

<a href={`https://www.${platform}.com/${username}`}>{platform}</a>
